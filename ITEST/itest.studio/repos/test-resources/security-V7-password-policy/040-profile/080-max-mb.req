PUT /rest/users/profile HTTP/1.1
Authorization: ${V7_PROFILE_BASIC_MAX_ASCII}
Cookie: NO_JSESSIONID=noAuth
Content-Type: application/json; charset=UTF-8

{
  "changePassword": {
    "newPassword": "${V7_MAX_MB}",
    "currentPassword": "${V7_MAX_ASCII}",
    "confirmPassword": "${V7_MAX_MB}"
  },
  "firstName": "V7",
  "lastName": "Profile",
  "displayName": "V7 Profile",
  "showHeader": false,
  "showFormulas": true,
  "testsPerPage": 20,
  "testsFailuresOnly": true,
  "testsFailuresPerTest": 20,
  "showComplexResult": true,
  "showRealNumbers": true,
  "treeView": "type",
  "email": "v7_profile@email"
}
